# Database (Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/secure_files?schema=public"

# JWT session signing secret (use strong random value)
JWT_SECRET="replace-with-a-strong-random-secret"

# Cookie settings
COOKIE_NAME="sid"
COOKIE_DOMAIN="localhost"
COOKIE_SECURE=false # set to true in production (HTTPS)

# SMTP for sending verification/reset emails (Ethereal or provider)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
FROM_EMAIL="no-reply@yourdomain.com"
FRONTEND_URL="http://localhost:3000"

# AWS S3 configuration
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...

# Presigned URL TTL (seconds)
PRESIGN_TTL=300
